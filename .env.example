# Local development remains the default and needs no S3 credentials.
STORAGE_BACKEND=local
UPLOAD_FOLDER=media/uploads

# Timeweb S3 (enable with STORAGE_BACKEND=s3 in deployment only).
S3_ENDPOINT=https://s3.twcstorage.ru
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=ru-1
S3_ADDRESSING_STYLE=path
S3_KEY_PREFIX=ukno
S3_PUBLIC_BASE_URL=
S3_PRESIGNED_URL_EXPIRES=3600

# Database. Individual fields safely support reserved URL characters in passwords.
USE_POSTGRES=False
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ukno
POSTGRES_USER=ukno_user
POSTGRES_PASSWORD=
